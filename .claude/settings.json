{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/hooks/format.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/hooks/stop.sh \"npm run check\"",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/node_modules/**)",
      "Read(./**/dist/**)",
      "Read(./**/release/**)",
      "Read(./**/*.min.js)",
      "Read(./package-lock.json)"
    ]
  },
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "15000"
  }
}
